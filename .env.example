# Copy to .env and replace every "change-me" value. Never commit .env.

# --- Local PostgreSQL (docker compose) ---
POSTGRES_DB=logitrack
POSTGRES_USER=logitrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Backend (FastAPI) ---
LOGITRACK_DATABASE_URL=postgresql+psycopg://logitrack:change-me@localhost:5433/logitrack
# Optional: defaults to the main URL with the database name "logitrack_test"
# LOGITRACK_TEST_DATABASE_URL=postgresql+psycopg://logitrack:change-me@localhost:5433/logitrack_test

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LOGITRACK_JWT_SECRET=change-me
LOGITRACK_ACCESS_TOKEN_MINUTES=480
# Set to true when served over HTTPS
LOGITRACK_COOKIE_SECURE=false
LOGITRACK_CORS_ORIGINS=["http://localhost:5190"]
LOGITRACK_TIMEZONE=Africa/Nairobi
LOGITRACK_DEFAULT_TURNAROUND_TARGET_MINUTES=120
LOGITRACK_BAY_OPERATING_HOURS_PER_DAY=12
